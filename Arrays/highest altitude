class Solution {
    public int largestAltitude(int[] gain) {
        int altitude = 0;
        int maxAltitude = 0;
        //gain is the array here and we will go till the end of this array
        for(int i=0;i<gain.length ;i++){
            altitude += gain[i];

            if(altitude > maxAltitude){
                maxAltitude = altitude;
            }
        }
        return maxAltitude;
    }
}
