package com.Vashika.BinarySearch;

// for when we don't know whether the array is ascending or descending

public class OrderAgnosticBS {
    public static void main(String[] args){
        int[] arr = {-18,-12,-4,0,2,4,5,15,16,18,22,45,98};
        int target = 98;
        int ans =orderBS(arr, target);
        System.out.println(ans);
    }
    static int orderBS(int[] arr, int target){
        int start = 0;
        int end = arr.length - 1;

        boolean isAsc = arr[start]<arr[end];
        while (start<=end) {
            int mid = start + (end - start) / 2;

            if (arr[mid] == target) {
                return mid;
            }

            if (isAsc) {
                if (target > arr[mid]) {
                    start = mid + 1;
                } else {
                    end = mid - 1;
                }
            } else {
                if (target < arr[mid]) {
                    start = mid + 1;
                } else {
                    end = mid - 1;
                }
            }
        }
        return -1;
    }
}
